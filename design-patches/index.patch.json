  "ops": [
    {
      "op": "replace-text",
      "tpl": 175,
      "expectTag": "div",
      "expect": "NO TIMES IN THIS PART OF THE DAY",
      "with": "{{= site.boardEmptyText }}",
      "dv": "DV-AVAIL"
    },
    {
      "op": "insert-after",
      "tpl": 676,
      "expectTag": "sc-if",
      "html": "<sc-if value=\"{{ sh.bCode }}\"><div style=\"padding:18px;border-radius:20px;background:var(--card);border:1.5px solid var(--cyanBrd);\"><div style=\"font-weight:800;font-size:17px;\">Enter the code we texted</div><div style=\"font-size:13.5px;color:var(--ink3);margin-top:3px;\">Sent to {{ sh.codePhone }} · 6 digits, 3 tries</div><div style=\"display:flex;gap:8px;margin-top:14px;\"><input value=\"{{ site.code }}\" onInput=\"{{ site.setCode }}\" inputmode=\"numeric\" autocomplete=\"one-time-code\" placeholder=\"123456\" style=\"flex:1;min-width:0;height:52px;padding:0 14px;border-radius:14px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:700;letter-spacing:.2em;\"><button onClick=\"{{ site.codeContinue }}\" style=\"flex:none;height:52px;padding:0 18px;border-radius:14px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:15px;\">Verify</button></div><sc-if value=\"{{ site.codeErr }}\"><div style=\"font-size:12.5px;color:#E5533D;margin-top:8px;font-weight:700;\">{{ site.codeErr }}</div></sc-if><button onClick=\"{{ site.resendCode }}\" style=\"margin-top:12px;font-size:13px;font-weight:700;color:var(--ink3);\">Send a new code</button></div></sc-if>",
      "dv": "DV-OTP"
    },
    {
      "op": "insert-after",
      "tpl": 729,
      "expectTag": "div",
      "html": "<sc-if value=\"{{ site.timeNote }}\"><div style=\"padding:14px 16px;border-radius:16px;background:var(--cyanSoft);border:1px solid var(--cyanBrd);font-size:13.5px;line-height:1.45;color:var(--cyanInk);\">{{ site.timeNote }}</div></sc-if>",
      "dv": "DV-AVAIL"
    },
    {
      "op": "insert-before",
      "tpl": 751,
      "expectTag": "sc-if",
      "html": "<sc-if value=\"{{ site.guestDetails }}\"><div style=\"display:flex;flex-direction:column;gap:10px;\"><input value=\"{{ site.name }}\" onInput=\"{{ site.setName }}\" autocomplete=\"name\" placeholder=\"Full name\" style=\"height:56px;padding:0 16px;border-radius:15px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:inherit;font-size:16px;font-weight:600;\"><sc-if value=\"{{ site.askPhone }}\"><input value=\"{{ site.phone }}\" onInput=\"{{ site.setPhone }}\" inputmode=\"tel\" autocomplete=\"tel\" placeholder=\"Mobile number\" style=\"height:56px;padding:0 16px;border-radius:15px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:inherit;font-size:16px;font-weight:600;\"><div style=\"font-size:12.5px;color:var(--ink3);\">We'll text your confirmation to this number.</div></sc-if></div></sc-if>",
      "dv": "DV-BOOK"
    },
    {
      "op": "insert-after",
      "tpl": 762,
      "expectTag": "sc-if",
      "html": "<sc-if value=\"{{ site.link.notice.show }}\"><sc-if value=\"{{ site.link.notice.ok }}\"><div style=\"text-align:center;padding:16px 0 6px;\"><div style=\"width:72px;height:72px;margin:0 auto;border-radius:50%;background:#1FB6FF;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 10px rgba(31,182,255,.12),0 0 50px rgba(31,182,255,.5);\"><svg width=\"34\" height=\"34\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 12.5l4.5 4.5L19 7\" stroke=\"#00131D\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div></div></sc-if><div style=\"padding:14px 16px;border-radius:16px;background:var(--inset);font-size:13.5px;line-height:1.5;color:var(--ink2);\">{{ site.link.notice.text }}</div><sc-if value=\"{{ site.link.notice.action }}\"><button onClick=\"{{ site.link.notice.actionClick }}\" style=\"height:60px;border-radius:18px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:17px;box-shadow:0 12px 34px rgba(31,182,255,.35);\">{{ site.link.notice.action }}</button></sc-if><sc-if value=\"{{ site.link.notice.smsHref }}\"><a href=\"{{ site.link.notice.smsHref }}\" style=\"height:56px;display:flex;align-items:center;justify-content:center;border-radius:18px;border:1px solid var(--line);color:var(--ink);font-weight:700;font-size:15.5px;\">{{ site.link.notice.smsLabel }}</a></sc-if><button onClick=\"{{ site.link.notice.home }}\" style=\"text-align:center;padding:10px;font-weight:700;font-size:14px;color:var(--ink3);\">Back to home</button></sc-if>",
      "dv": "DV-LINK-DEAD"
    },
    {
      "op": "insert-after",
      "tpl": 762,
      "expectTag": "sc-if",
      "html": "<sc-if value=\"{{ site.link.pay.show }}\"><div style=\"padding:16px 18px;border-radius:20px;background:var(--inset);\"><div style=\"font-family:'Archivo',sans-serif;font-stretch:112%;font-weight:900;font-size:20px;\">{{ site.link.pay.title }}</div><div style=\"font-size:13.5px;color:var(--ink3);margin-top:4px;\">{{ site.link.pay.sub }}</div><div style=\"margin-top:14px;border-top:1px solid var(--line);padding-top:10px;\"><sc-for list=\"{{ site.link.pay.lines }}\" as=\"l\"><div style=\"display:flex;justify-content:space-between;gap:12px;padding:6px 0;font-size:14.5px;\"><span style=\"color:{{ l.lc }};\">{{ l.label }}</span><span style=\"font-weight:800;color:{{ l.vc }};\">{{ l.value }}</span></div></sc-for></div><div style=\"display:flex;justify-content:space-between;align-items:baseline;margin-top:8px;padding-top:12px;border-top:1px solid var(--line);\"><span style=\"font-weight:800;\">{{ site.link.pay.dueLabel }}</span><span style=\"font-family:'Archivo',sans-serif;font-stretch:112%;font-weight:900;font-size:26px;\">{{ site.link.pay.due }}</span></div><div style=\"font-size:12.5px;color:var(--ink3);margin-top:4px;\">{{ site.link.pay.dueSub }}</div></div></sc-if>",
      "dv": "DV-LINK-PAY"
    },
    {
      "op": "insert-after",
      "tpl": 762,
      "expectTag": "sc-if",
      "html": "<sc-if value=\"{{ site.link.sheetStepUp }}\"><div style=\"padding:18px;border-radius:20px;background:var(--card);border:1.5px solid var(--cyanBrd);\"><div style=\"font-weight:800;font-size:17px;\">{{ site.link.su.title }}</div><div style=\"font-size:13.5px;color:var(--ink3);margin-top:3px;\">{{ site.link.su.sub }}</div><sc-if value=\"{{ site.link.su.pin }}\"><div style=\"display:flex;gap:8px;margin-top:14px;\"><input value=\"{{ site.link.su.value }}\" onInput=\"{{ site.link.su.setValue }}\" type=\"password\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"PIN\" style=\"flex:1;min-width:0;height:52px;padding:0 14px;border-radius:14px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:inherit;font-size:16px;font-weight:600;\"><button onClick=\"{{ site.link.su.submit }}\" style=\"flex:none;height:52px;padding:0 18px;border-radius:14px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:15px;\">{{ site.link.su.submitLabel }}</button></div></sc-if><sc-if value=\"{{ site.link.su.code }}\"><div style=\"display:flex;gap:8px;margin-top:14px;\"><input value=\"{{ site.link.su.value }}\" onInput=\"{{ site.link.su.setValue }}\" inputmode=\"numeric\" autocomplete=\"one-time-code\" placeholder=\"6-digit code\" style=\"flex:1;min-width:0;height:52px;padding:0 14px;border-radius:14px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:inherit;font-size:16px;font-weight:600;\"><button onClick=\"{{ site.link.su.submit }}\" style=\"flex:none;height:52px;padding:0 18px;border-radius:14px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:15px;\">{{ site.link.su.submitLabel }}</button></div></sc-if><sc-if value=\"{{ site.link.su.create }}\"><div style=\"display:flex;gap:8px;margin-top:14px;\"><input value=\"{{ site.link.su.value }}\" onInput=\"{{ site.link.su.setValue }}\" type=\"password\" inputmode=\"numeric\" autocomplete=\"new-password\" placeholder=\"New PIN\" style=\"flex:1;min-width:0;height:52px;padding:0 14px;border-radius:14px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:inherit;font-size:16px;font-weight:600;\"><button onClick=\"{{ site.link.su.submit }}\" style=\"flex:none;height:52px;padding:0 18px;border-radius:14px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:15px;\">{{ site.link.su.submitLabel }}</button></div></sc-if><sc-if value=\"{{ site.link.su.send }}\"><button onClick=\"{{ site.link.su.sendCode }}\" style=\"margin-top:12px;height:46px;padding:0 16px;border-radius:13px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:14px;\">{{ site.link.su.sendLabel }}</button></sc-if><sc-if value=\"{{ site.link.su.err }}\"><div style=\"font-size:12.5px;color:#E5533D;margin-top:8px;font-weight:700;\">{{ site.link.su.err }}</div></sc-if><sc-if value=\"{{ site.link.su.alt }}\"><div><button onClick=\"{{ site.link.su.altClick }}\" style=\"margin-top:12px;font-size:13px;font-weight:700;color:var(--ink3);\">{{ site.link.su.alt }}</button></div></sc-if></div><div style=\"padding:14px 16px;border-radius:16px;background:var(--inset);font-size:13.5px;line-height:1.5;color:var(--ink2);\">{{ site.link.su.note }}</div></sc-if>",
      "dv": "DV-STEPUP"
    },
    {
      "op": "wrap-if",
      "tpl": 772,
      "expectTag": "div",
      "cond": "site.sheetSummary",
      "dv": "DV-LINK"
    },
    {
      "op": "insert-before",
      "tpl": 613,
      "expectTag": "sc-if",
      "html": "<sc-if value=\"{{ site.link.joinStepUp }}\"><div style=\"display:flex;flex-direction:column;gap:10px;margin-top:24px;\"><div style=\"padding:18px;border-radius:20px;background:var(--card);border:1.5px solid var(--cyanBrd);\"><div style=\"font-weight:800;font-size:17px;\">{{ site.link.su.title }}</div><div style=\"font-size:13.5px;color:var(--ink3);margin-top:3px;\">{{ site.link.su.sub }}</div><sc-if value=\"{{ site.link.su.pin }}\"><div style=\"display:flex;gap:8px;margin-top:14px;\"><input value=\"{{ site.link.su.value }}\" onInput=\"{{ site.link.su.setValue }}\" type=\"password\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"PIN\" style=\"flex:1;min-width:0;height:52px;padding:0 14px;border-radius:14px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:inherit;font-size:16px;font-weight:600;\"><button onClick=\"{{ site.link.su.submit }}\" style=\"flex:none;height:52px;padding:0 18px;border-radius:14px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:15px;\">{{ site.link.su.submitLabel }}</button></div></sc-if><sc-if value=\"{{ site.link.su.code }}\"><div style=\"display:flex;gap:8px;margin-top:14px;\"><input value=\"{{ site.link.su.value }}\" onInput=\"{{ site.link.su.setValue }}\" inputmode=\"numeric\" autocomplete=\"one-time-code\" placeholder=\"6-digit code\" style=\"flex:1;min-width:0;height:52px;padding:0 14px;border-radius:14px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:inherit;font-size:16px;font-weight:600;\"><button onClick=\"{{ site.link.su.submit }}\" style=\"flex:none;height:52px;padding:0 18px;border-radius:14px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:15px;\">{{ site.link.su.submitLabel }}</button></div></sc-if><sc-if value=\"{{ site.link.su.create }}\"><div style=\"display:flex;gap:8px;margin-top:14px;\"><input value=\"{{ site.link.su.value }}\" onInput=\"{{ site.link.su.setValue }}\" type=\"password\" inputmode=\"numeric\" autocomplete=\"new-password\" placeholder=\"New PIN\" style=\"flex:1;min-width:0;height:52px;padding:0 14px;border-radius:14px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:inherit;font-size:16px;font-weight:600;\"><button onClick=\"{{ site.link.su.submit }}\" style=\"flex:none;height:52px;padding:0 18px;border-radius:14px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:15px;\">{{ site.link.su.submitLabel }}</button></div></sc-if><sc-if value=\"{{ site.link.su.send }}\"><button onClick=\"{{ site.link.su.sendCode }}\" style=\"margin-top:12px;height:46px;padding:0 16px;border-radius:13px;background:#1FB6FF;color:#00131D;font-weight:800;font-size:14px;\">{{ site.link.su.sendLabel }}</button></sc-if><sc-if value=\"{{ site.link.su.err }}\"><div style=\"font-size:12.5px;color:#E5533D;margin-top:8px;font-weight:700;\">{{ site.link.su.err }}</div></sc-if><sc-if value=\"{{ site.link.su.alt }}\"><div><button onClick=\"{{ site.link.su.altClick }}\" style=\"margin-top:12px;font-size:13px;font-weight:700;color:var(--ink3);\">{{ site.link.su.alt }}</button></div></sc-if></div><div style=\"padding:14px 16px;border-radius:16px;background:var(--inset);font-size:13.5px;line-height:1.5;color:var(--ink2);\">{{ site.link.su.note }}</div></div></sc-if>",
      "dv": "DV-LINK-JOIN"
    },
    {
      "op": "insert-before",
      "tpl": 613,
      "expectTag": "sc-if",
      "html": "<sc-if value=\"{{ site.link.joinEmail }}\"><div style=\"display:flex;flex-direction:column;gap:10px;margin-top:24px;\"><div style=\"display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:14px;background:var(--inset);font-size:14px;color:var(--ink2);\">Joining as<span style=\"font-family:'JetBrains Mono',monospace;font-weight:800;color:var(--ink);\">{{ site.link.joinAs }}</span></div><input value=\"{{ jv.email }}\" onInput=\"{{ jv.setEmail }}\" inputmode=\"email\" autocomplete=\"email\" placeholder=\"Email (for receipts)\" style=\"height:56px;padding:0 16px;border-radius:15px;border:1px solid var(--line);background:var(--inset);color:var(--ink);font-family:inherit;font-size:16px;font-weight:600;\"></div></sc-if>",
      "dv": "DV-LINK-JOIN"
    }
  ]
}

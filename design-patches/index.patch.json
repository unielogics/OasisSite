{
  "head": {
    "drop": [
      {
        "tag": "link",
        "attr": "rel",
        "value": "preconnect",
        "dv": "DV-FONTS"
      },
      {
        "tag": "link",
        "attr": "rel",
        "value": "stylesheet",
        "dv": "DV-FONTS"
      },
      {
        "tag": "script",
        "attr": "src",
        "value": "/assets/image-slot.js",
        "dv": "DV-IMG"
      }
    ]
